<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SolatWaktuWidget</AssemblyName>
    <RootNamespace>SolatWaktu.Widget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>Solat Waktu Widget</Product>
    <Company>Solat Waktu</Company>
    <Description>Widget waktu solat Malaysia untuk Windows 11</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolatWaktu.Core\SolatWaktu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="SolatWaktu.Widget.Assets.app.ico" />
    <EmbeddedResource Include="Assets\azan-short.mp3" LogicalName="SolatWaktu.Widget.Assets.azan-short.mp3" />
    <EmbeddedResource Include="Assets\azan-long.mp3" LogicalName="SolatWaktu.Widget.Assets.azan-long.mp3" />
    <EmbeddedResource Include="Assets\mosque-purple.jpg" LogicalName="SolatWaktu.Widget.Assets.mosque-purple.jpg" />
  </ItemGroup>

</Project>
